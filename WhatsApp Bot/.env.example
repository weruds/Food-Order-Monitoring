# WhatsApp Bot — Environment Variables
# Copy this file to .env and fill in your values

# ── WhatsApp Session ──────────────────────────────────────
SESSION_DATA_PATH=./.wwebjs_auth

# ── Food Group Chat ID ────────────────────────────────────
# Run the bot once — it will print all group IDs in the console.
# Copy your food committee group ID here.
# Format: XXXXXXXXXX-XXXXXXXXXX@g.us
FOOD_GROUP_ID=

# ── HTTP API ──────────────────────────────────────────────
# Port the API server listens on (dashboard calls http://localhost:PORT)
API_PORT=3333

# Secret token — set any string here, then put the SAME value as
# WA_BOT_SECRET in index.html so the dashboard can authenticate.
API_SECRET=your-secret-here
